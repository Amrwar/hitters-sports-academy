# Copy to .env for local development. Never commit .env.
DATABASE_URL="postgresql://hitters:hitters_dev@localhost:5440/hitters?schema=public"

# Used by the test suite (vitest). Must be a separate database.
TEST_DATABASE_URL="postgresql://hitters:hitters_dev@localhost:5440/hitters_test?schema=public"

# Public origin used in emails (verification / reset links).
APP_URL="http://localhost:3000"

# Set to "true" to log outgoing emails to the console instead of sending (default when no provider is configured).
MAIL_DEV_LOG="true"

# Production bootstrap (Vercel): creates the first super admin on deploy if none exists.
# Remove BOOTSTRAP_ADMIN_PASSWORD after the first successful deploy.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# ---------------------------------------------------------------- Payments
# Leave PAYMENT_PROVIDER unset to take money at the club only. Everything else keeps working: invoices,
# cash and card at the desk, refunds, credit, memberships and coupons. Online checkout is hidden rather
# than broken, and appears the day a gateway is connected.
# PAYMENT_PROVIDER=paymob

# Paymob (Egypt). All five are required before the adapter registers itself; a half-configured gateway
# would be reported as connected and fail on the first player to tap Pay.
# PAYMOB_SECRET_KEY=          # creates payment intentions
# PAYMOB_PUBLIC_KEY=          # builds the hosted checkout URL
# PAYMOB_API_KEY=             # exchanged for the token refunds need
# PAYMOB_HMAC_SECRET=         # verifies callbacks; without it every callback is refused
# PAYMOB_INTEGRATION_IDS=     # comma separated, e.g. 1234567,1234568 (card, wallet)
# PAYMOB_BASE_URL=            # optional; defaults to Egypt (https://accept.paymob.com)
#
# The callback URL to register in the Paymob dashboard is:
#   {APP_URL}/api/payments/webhook/paymob
