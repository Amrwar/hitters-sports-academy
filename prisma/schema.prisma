// HITTERS Sports Academy - core data model (phase: foundation, auth, authorization).
// Matchmaking (join requests), programs and payments are added in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Enums

/// Roles that apply across every location. Everything else is granted per location via StaffMembership.
enum GlobalRole {
  SUPER_ADMIN
  ACADEMY_OWNER
}

/// Roles scoped to a single location.
enum StaffRole {
  LOCATION_MANAGER
  RECEPTIONIST
  TRAINER
  ASSESSOR
  FINANCE_MANAGER
}

/// Union of all roles, used by the permission matrix.
enum Role {
  SUPER_ADMIN
  ACADEMY_OWNER
  LOCATION_MANAGER
  RECEPTIONIST
  TRAINER
  ASSESSOR
  FINANCE_MANAGER
  PLAYER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum PlayerLevel {
  A
  B
  C
  D
}

enum PlayerSide {
  LEFT
  RIGHT
  BOTH
}

enum AssessmentKind {
  INITIAL
  REASSESSMENT
  LEVEL_CHANGE
}

enum AssessmentRequestStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MatchTypePreference {
  FRIENDLY
  COMPETITIVE
  ANY
}

enum TrainingKind {
  PRIVATE
  PROGRAM
  CLINIC
  ASSESSMENT
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS
  PRIVATE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

enum CourtType {
  INDOOR
  OUTDOOR
  PANORAMIC
}

enum CourtStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum TokenType {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET
}

enum PricingRuleKind {
  PEAK
  OFF_PEAK
  WEEKEND
  MEMBERSHIP_DISCOUNT
  CUSTOM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  PLAYER_APP
  ADMIN
  RECEPTION
}

enum ParticipantRole {
  ORGANIZER
  PLAYER
}

enum ParticipantStatus {
  INVITED
  JOINED
  DECLINED
  REMOVED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  WAIVED
  CANCELLED
  FAILED
}

/// How the money physically moved. The gateway, if any, is Payment.provider; "CARD" says nothing about
/// whether it was taken at the desk or online.
enum PaymentMethod {
  NONE
  CASH
  CARD
  WALLET
  TRANSFER
  /// Settled from the player's academy credit balance rather than new money.
  CREDIT
}

/// State of one attempt to take money through a provider. Only a provider confirmation moves an intent to
/// SUCCEEDED; nothing the browser reports can.
enum PaymentIntentStatus {
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PART_PAID
  PAID
  VOID
  REFUNDED
}

enum InvoiceLineKind {
  COURT
  LESSON
  PROGRAM
  PACKAGE
  MEMBERSHIP
  /// Cancellation and no-show charges.
  FEE
  /// Always negative.
  DISCOUNT
  /// Always negative: academy credit applied to the invoice.
  CREDIT
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RefundDestination {
  /// Back through the provider that took the money.
  ORIGINAL
  /// To the player's academy credit balance.
  CREDIT
  /// Handed back at the desk.
  CASH
}

enum CreditEntryKind {
  TOPUP
  REFUND
  ADJUSTMENT
  SPEND
  EXPIRY
}

/// States of one paid membership term. Distinct from MembershipStatus, which belongs to StaffMembership.
enum MembershipTermStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum CouponKind {
  PERCENT
  FIXED
}

/// What a club accepts. ONLINE alone means a booking is not confirmed until the money arrives.
enum PaymentTiming {
  AT_CLUB
  ONLINE
  BOTH
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  /// Claimed by a worker and handed to the provider; stops a second worker sending it again.
  SENDING
  SENT
  FAILED
  /// The user's preferences turned this channel off, so nothing was attempted.
  SKIPPED
}

/// Groups notification types for preferences and for the notification centre's filters.
enum NotificationCategory {
  BOOKING
  MATCHMAKING
  TRAINING
  ACADEMY
  MESSAGING
  BILLING
}

enum MessageThreadKind {
  GAME
  PROGRAM
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

// ---------------------------------------------------------------- Games (planned padel sessions)

/// Player-count template. maxPlayers is stored per session so new formats need no schema change.
enum GameFormat {
  SINGLES
  DOUBLES
  OPEN
}

enum GameVisibility {
  PRIVATE
  PUBLIC
}

enum GameStatus {
  DRAFT
  OPEN
  FULL
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum GameCostMode {
  FREE
  SPLIT_EVENLY
  ORGANIZER_PAYS
  FIXED_PER_PLAYER
}

enum GameParticipantRole {
  ORGANIZER
  PLAYER
}

enum GameParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
  LEFT
  REMOVED
}

/// Lifecycle of a request to join a game. WAITLISTED = the game is full right now; it returns to PENDING when a spot reopens.
enum GameRequestStatus {
  PENDING
  WAITLISTED
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum GameRequestKind {
  SOLO
  PAIR
}

/// Who may request the open spots. PAIRS_ONLY is a challenge: the organizer's pair wants an opposing pair.
enum GameJoinPolicy {
  OPEN
  SOLO_ONLY
  PAIRS_ONLY
}

/// EXACT = only the listed levels. ADJACENT = one rank above or below is welcome too, when the academy allows it.
enum GameLevelPolicy {
  EXACT
  ADJACENT
}

enum PairStatus {
  PENDING
  ACTIVE
}

// ---------------------------------------------------------------- Academy (coaching and programs)

enum TrainerStatus {
  ACTIVE
  INACTIVE
}

enum LessonStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum NoteVisibility {
  PRIVATE
  SHARED
}

enum ProgramCategory {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  JUNIOR
  COMPETITIVE
  INTENSIVE
  GROUP_COACHING
}

enum ProgramStatus {
  DRAFT
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProgramSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ENROLLED
  WAITLISTED
  CANCELLED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PurchaseStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

// ---------------------------------------------------------------- Identity

/// One account per person across all HITTERS locations.
model User {
  id              String      @id @default(cuid())
  email           String      @unique
  phone           String?     @unique
  passwordHash    String
  name            String
  globalRole      GlobalRole?
  status          UserStatus  @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  playerProfile           PlayerProfile?
  sessions                Session[]
  verificationTokens      VerificationToken[]
  memberships             StaffMembership[]        @relation("MembershipUser")
  createdMemberships      StaffMembership[]        @relation("MembershipCreatedBy")
  assessmentsGiven        Assessment[]             @relation("AssessmentAssessor")
  assessmentRequests      AssessmentRequest[]      @relation("RequestAssessor")
  trainingGiven           TrainingRecord[]         @relation("TrainingTrainer")
  trainingRecorded        TrainingRecord[]         @relation("TrainingCreatedBy")
  notifications           Notification[]
  auditLogs               AuditLog[]
  bookings                Booking[]                @relation("BookingPlayer")
  createdBookings         Booking[]                @relation("BookingCreatedBy")
  cancelledBookings       Booking[]                @relation("BookingCancelledBy")
  participations          BookingParticipant[]
  organizedGames          GameSession[]            @relation("GameOrganizer")
  cancelledGames          GameSession[]            @relation("GameCancelledBy")
  gameParticipations      GameParticipant[]        @relation("GameParticipantUser")
  gameInvitesSent         GameParticipant[]        @relation("GameParticipantInvitedBy")
  gameRequests            GameJoinRequest[]        @relation("GameRequestUser")
  gameRequestsDecided     GameJoinRequest[]        @relation("GameRequestDecidedBy")
  pairsAsA                Pair[]                   @relation("PairPlayerA")
  pairsAsB                Pair[]                   @relation("PairPlayerB")
  pairsCreated            Pair[]                   @relation("PairCreatedBy")
  trainerProfile          TrainerProfile?
  lessonsTaken            Lesson[]                 @relation("LessonPlayer")
  lessonsCancelled        Lesson[]                 @relation("LessonCancelledBy")
  lessonsCreated          Lesson[]                 @relation("LessonCreatedBy")
  progressNotes           ProgressNote[]           @relation("NotePlayer")
  enrollments             ProgramEnrollment[]      @relation("EnrollmentPlayer")
  enrollmentsCreated      ProgramEnrollment[]      @relation("EnrollmentCreatedBy")
  attendanceMarked        ProgramAttendance[]      @relation("AttendanceMarkedBy")
  programsCreated         Program[]                @relation("ProgramCreatedBy")
  purchases               PackagePurchase[]        @relation("PurchasePlayer")
  purchasesCreated        PackagePurchase[]        @relation("PurchaseCreatedBy")
  notificationPreferences NotificationPreference[]
  templatesUpdated        NotificationTemplate[]   @relation("TemplateUpdatedBy")
  messagesSent            Message[]                @relation("MessageSender")
  messagesDeleted         Message[]                @relation("MessageDeletedBy")
  reportsMade             MessageReport[]          @relation("ReportReporter")
  reportsReviewed         MessageReport[]          @relation("ReportReviewedBy")
  threadsLocked           MessageThread[]          @relation("ThreadLockedBy")
  academySettingsUpdated  AcademySettings[]        @relation("AcademySettingsUpdatedBy")
  invoices                Invoice[]                @relation("InvoicePlayer")
  invoicesCreated         Invoice[]                @relation("InvoiceCreatedBy")
  paymentsMade            Payment[]                @relation("PaymentPayer")
  paymentsReceived        Payment[]                @relation("PaymentReceivedBy")
  paymentIntents          PaymentIntent[]          @relation("IntentCreatedBy")
  refundsRequested        Refund[]                 @relation("RefundRequestedBy")
  creditAccount           CreditAccount?
  creditEntries           CreditEntry[]            @relation("CreditEntryCreatedBy")
  memberships_            Membership[]             @relation("MembershipPlayer")
  membershipsCreated      Membership[]             @relation("MembershipCreatedBy")
  couponsCreated          Coupon[]                 @relation("CouponCreatedBy")
  couponRedemptions       CouponRedemption[]       @relation("CouponRedemptionPlayer")

  @@index([status])
  @@index([globalRole])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id         String    @id @default(cuid())
  userId     String
  type       TokenType
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

/// Role -> permission grants. Seeded from src/lib/auth/permissions.ts and authoritative at runtime.
model RolePermission {
  id         String @id @default(cuid())
  role       Role
  permission String

  @@unique([role, permission])
  @@index([role])
}

// ---------------------------------------------------------------- Players

model PlayerProfile {
  id             String              @id @default(cuid())
  userId         String              @unique
  /// Official HITTERS level. Only set through the assessment workflow or a staff level change.
  level          PlayerLevel?
  levelUpdatedAt DateTime?
  /// What the player believes their level is; never used for official placement.
  selfLevel      PlayerLevel?
  photoUrl       String?
  side           PlayerSide          @default(RIGHT)
  matchType      MatchTypePreference @default(ANY)
  playStyle      String?             @db.VarChar(80)
  yearsPlaying   Int?
  /// Keys from PREFERRED_TIMES in src/lib/catalog.ts
  preferredTimes String[]            @default([])
  bio            String?             @db.VarChar(500)
  dateOfBirth    DateTime?           @db.Date
  homeLocationId String?
  visibility     ProfileVisibility   @default(MEMBERS)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeLocation       Location?           @relation(fields: [homeLocationId], references: [id], onDelete: SetNull)
  preferredLocations Location[]          @relation("PreferredLocations")
  assessments        Assessment[]
  assessmentRequests AssessmentRequest[]
  trainingRecords    TrainingRecord[]

  @@index([level])
  @@index([homeLocationId])
}

/// A/B/C/D placement performed by an assessor at a location. The latest assessment sets PlayerProfile.level.
model Assessment {
  id              String         @id @default(cuid())
  playerProfileId String
  assessorId      String
  locationId      String
  kind            AssessmentKind @default(INITIAL)
  level           PlayerLevel
  previousLevel   PlayerLevel?
  notes           String?        @db.VarChar(2000)
  /// Internal notes visible to staff only.
  staffNotes      String?        @db.VarChar(2000)
  scores          Json?
  assessedAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())

  playerProfile PlayerProfile      @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  assessor      User               @relation("AssessmentAssessor", fields: [assessorId], references: [id], onDelete: Restrict)
  location      Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  request       AssessmentRequest? @relation("RequestResult")

  @@index([playerProfileId, assessedAt(sort: Desc)])
  @@index([locationId, assessedAt(sort: Desc)])
  @@index([assessorId])
}

/// Player-initiated assessment workflow: REQUESTED -> SCHEDULED -> COMPLETED (or CANCELLED).
model AssessmentRequest {
  id              String                  @id @default(cuid())
  playerProfileId String
  locationId      String
  kind            AssessmentKind          @default(INITIAL)
  status          AssessmentRequestStatus @default(REQUESTED)
  note            String?                 @db.VarChar(500)
  scheduledAt     DateTime?
  assessorId      String?
  assessmentId    String?                 @unique
  cancelReason    String?                 @db.VarChar(500)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  location      Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  assessor      User?         @relation("RequestAssessor", fields: [assessorId], references: [id], onDelete: SetNull)
  assessment    Assessment?   @relation("RequestResult", fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([playerProfileId, status])
  @@index([locationId, status, scheduledAt])
}

/// Admin-configurable meaning and ordering of the official levels. rank 1 is the strongest.
model LevelDefinition {
  level       PlayerLevel @id
  rank        Int         @unique
  label       String      @db.VarChar(40)
  description String      @db.VarChar(500)
  updatedAt   DateTime    @updatedAt
}

/// Training attended by a player (private sessions, programs, clinics). Recorded by trainers/managers.
model TrainingRecord {
  id              String       @id @default(cuid())
  playerProfileId String
  locationId      String?
  trainerId       String?
  kind            TrainingKind @default(PRIVATE)
  title           String       @db.VarChar(120)
  heldAt          DateTime
  durationMinutes Int          @default(60)
  notes           String?      @db.VarChar(1000)
  createdById     String?
  createdAt       DateTime     @default(now())

  playerProfile PlayerProfile @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  location      Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  trainer       User?         @relation("TrainingTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("TrainingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([playerProfileId, heldAt(sort: Desc)])
  @@index([locationId, heldAt(sort: Desc)])
}

// ---------------------------------------------------------------- Locations

model Location {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  city         String
  area         String
  address      String
  timezone     String         @default("Africa/Cairo")
  phone        String?
  email        String?
  status       LocationStatus @default(ACTIVE)
  description  String?        @db.VarChar(2000)
  /// Keys from the facilities catalogue (src/lib/catalog.ts).
  facilities   String[]       @default([])
  /// Seven entries, Sunday first: { opensAt, closesAt } in minutes or null when closed.
  openingHours Json?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  courts              Court[]
  bookings            Booking[]
  gameSessions        GameSession[]
  trainerLocations    TrainerLocation[]
  trainerAvailability TrainerAvailability[]
  lessons             Lesson[]
  programs            Program[]
  packages            TrainingPackage[]
  photos              LocationPhoto[]
  bookingPolicy       BookingPolicy?
  pricingRules        PricingRule[]
  memberships         StaffMembership[]
  assessments         Assessment[]
  assessmentRequests  AssessmentRequest[]
  trainingRecords     TrainingRecord[]
  homePlayers         PlayerProfile[]
  preferredBy         PlayerProfile[]       @relation("PreferredLocations")
  auditLogs           AuditLog[]
  invoices            Invoice[]
  payments            Payment[]
  paymentPolicy       PaymentPolicy?
  membershipPlans     MembershipPlan[]
  coupons             Coupon[]

  @@index([status])
  @@index([city])
}

/// Photos are URLs (brand library or an external/object-storage URL). Upload pipeline comes with the storage provider.
model LocationPhoto {
  id         String   @id @default(cuid())
  locationId String
  url        String
  alt        String?  @db.VarChar(200)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, sortOrder])
}

/// Per-location booking rules consumed by the availability engine and, later, the booking service.
model BookingPolicy {
  id                         String   @id @default(cuid())
  locationId                 String   @unique
  advanceBookingDays         Int      @default(14)
  minNoticeMinutes           Int      @default(60)
  cancellationCutoffHours    Int      @default(12)
  maxActiveBookingsPerPlayer Int      @default(3)
  requireVerifiedEmail       Boolean  @default(true)
  /// Durations (minutes) a player may book, unless a court overrides them.
  allowedDurations           Int[]    @default([60, 90, 120])
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

/// Price modifiers layered over the base hourly rate from CourtAvailability.
/// courtId null = every court at the location. Applied in ascending priority order.
model PricingRule {
  id                String          @id @default(cuid())
  locationId        String
  courtId           String?
  name              String
  kind              PricingRuleKind
  /// Empty = every day. 0 = Sunday ... 6 = Saturday.
  daysOfWeek        Int[]           @default([])
  startsAt          Int?
  endsAt            Int?
  /// Absolute hourly price that replaces the base when set.
  priceCents        Int?
  /// Percentage adjustment applied to the running price (e.g. 25 or -15).
  adjustmentPercent Int?
  /// For MEMBERSHIP_DISCOUNT: tier key the player must hold; null = any member.
  membershipTier    String?
  priority          Int             @default(100)
  active            Boolean         @default(true)
  validFrom         DateTime?
  validTo           DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  court    Court?   @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([locationId, active, priority])
  @@index([courtId])
}

model Court {
  id               String      @id @default(cuid())
  locationId       String
  name             String
  type             CourtType
  status           CourtStatus @default(ACTIVE)
  sortOrder        Int         @default(0)
  surface          String?
  description      String?     @db.VarChar(500)
  /// Overrides BookingPolicy.allowedDurations when non-empty.
  durationsMinutes Int[]       @default([])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  location        Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  availability    CourtAvailability[]
  closures        CourtClosure[]
  pricingRules    PricingRule[]
  bookings        Booking[]
  gameSessions    GameSession[]
  lessons         Lesson[]
  programSessions ProgramSession[]

  @@unique([locationId, name])
  @@index([locationId, status])
}

/// Weekly operating template for a court. Times are minutes from midnight in the location timezone.
/// priceCents is the base hourly rate; PricingRule layers peak/weekend/membership adjustments on top.
model CourtAvailability {
  id          String   @id @default(cuid())
  courtId     String
  dayOfWeek   Int // 0 = Sunday ... 6 = Saturday
  opensAt     Int
  closesAt    Int
  slotMinutes Int      @default(60)
  priceCents  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, dayOfWeek, opensAt])
  @@index([courtId, dayOfWeek])
}

/// Maintenance or event window during which a court cannot be booked.
model CourtClosure {
  id        String   @id @default(cuid())
  courtId   String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, startsAt])
}

// ---------------------------------------------------------------- Bookings

/// A court reservation. Who plays lives in BookingParticipant; money lives in Payment.
/// Active bookings (PENDING, CONFIRMED) cannot overlap on a court: enforced by a Postgres
/// exclusion constraint (see migration 20261003040000_bookings) in addition to the service-level lock.
model Booking {
  id                 String        @id @default(cuid())
  confirmationCode   String        @unique
  courtId            String
  locationId         String
  /// Account that holds the reservation. Null only for staff-created guest bookings.
  playerId           String?
  guestName          String?       @db.VarChar(80)
  guestPhone         String?       @db.VarChar(30)
  startsAt           DateTime
  endsAt             DateTime
  durationMinutes    Int
  status             BookingStatus @default(CONFIRMED)
  source             BookingSource @default(PLAYER_APP)
  priceCents         Int
  currency           String        @default("EGP")
  notes              String?       @db.VarChar(500)
  createdById        String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?       @db.VarChar(500)
  rescheduledFromId  String?       @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  court           Court                @relation(fields: [courtId], references: [id], onDelete: Restrict)
  location        Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  player          User?                @relation("BookingPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  createdBy       User?                @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy     User?                @relation("BookingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  rescheduledFrom Booking?             @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Booking?             @relation("Reschedule")
  participants    BookingParticipant[]
  payments        Payment[]
  invoices        Invoice[]
  gameSession     GameSession?

  @@index([courtId, startsAt])
  @@index([locationId, startsAt])
  @@index([playerId, startsAt(sort: Desc)])
  @@index([status, startsAt])
}

/// Who takes part in a booked session. Matchmaking will add participants to existing bookings.
model BookingParticipant {
  id        String            @id @default(cuid())
  bookingId String
  userId    String?
  guestName String?           @db.VarChar(80)
  role      ParticipantRole   @default(PLAYER)
  status    ParticipantStatus @default(JOINED)
  createdAt DateTime          @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, userId])
  @@index([userId])
}

/// Money owed or taken for a booking. No provider is connected yet: records are created PENDING
/// and settled by staff (cash/card at venue) until online payments ship.
/// Money owed or taken for a booking, a lesson, a program enrollment or a package. Exactly one target is set.
/// Money arriving for something. A payment never carries card details: `provider` and `providerRef` are
/// the only link to the gateway, and the gateway holds the instrument.
///
/// The entity columns (bookingId, lessonId, ...) say what was paid for and are what the booking, lesson and
/// enrollment screens read. The invoice says what was owed. Both are written together by
/// `src/server/services/payments.ts`, which is the only writer; nothing else may create a Payment row.
model Payment {
  id             String        @id @default(cuid())
  invoiceId      String?
  intentId       String?
  bookingId      String?
  lessonId       String?
  enrollmentId   String?
  purchaseId     String?
  membershipId   String?
  payerId        String?
  locationId     String?
  amountCents    Int
  currency       String        @default("EGP")
  status         PaymentStatus @default(PENDING)
  method         PaymentMethod @default(NONE)
  provider       String?
  providerRef    String?
  /// Caller-supplied key that makes taking this payment safe to retry. Unique across every payment.
  idempotencyKey String?       @unique
  /// Free-text reference a receptionist can tie to a till slip or a transfer.
  reference      String?       @db.VarChar(120)
  note           String?       @db.VarChar(300)
  receivedById   String?
  paidAt         DateTime?
  refundedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  invoice    Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  intent     PaymentIntent?     @relation(fields: [intentId], references: [id], onDelete: SetNull)
  booking    Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lesson     Lesson?            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrollment ProgramEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  purchase   PackagePurchase?   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  membership Membership?        @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  payer      User?              @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: SetNull)
  receivedBy User?              @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  location   Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  refunds    Refund[]

  @@index([bookingId])
  @@index([lessonId])
  @@index([enrollmentId])
  @@index([purchaseId])
  @@index([invoiceId])
  @@index([status])
  @@index([locationId, paidAt(sort: Desc)])
  @@index([payerId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------- Games

/// A planned padel game on a reserved court. The reservation (Booking) and the money (Payment) stay separate;
/// the session owns who plays, how many spots exist and how they are filled.
/// Capacity is enforced in the service inside a transaction that locks the session row (see game-sessions.ts).
model GameSession {
  id                 String              @id @default(cuid())
  code               String              @unique
  organizerId        String
  bookingId          String              @unique
  locationId         String
  courtId            String
  startsAt           DateTime
  endsAt             DateTime
  format             GameFormat          @default(DOUBLES)
  /// Total players including the organizer. 4 for doubles; stored so future formats need no schema change.
  maxPlayers         Int                 @default(4)
  /// Official levels welcome. Empty = any level.
  levels             PlayerLevel[]       @default([])
  matchType          MatchTypePreference @default(ANY)
  visibility         GameVisibility      @default(PRIVATE)
  status             GameStatus          @default(DRAFT)
  /// Remaining spots may be requested by players who were not invited.
  openToRequests     Boolean             @default(false)
  joinPolicy         GameJoinPolicy      @default(OPEN)
  levelPolicy        GameLevelPolicy     @default(EXACT)
  /// Set when the organizer plays as a pair (team A of a challenge).
  pairId             String?
  costMode           GameCostMode        @default(SPLIT_EVENLY)
  /// Set for FIXED_PER_PLAYER; for SPLIT_EVENLY the share is derived from the booking price.
  costPerPlayerCents Int?
  currency           String              @default("EGP")
  description        String?             @db.VarChar(500)
  /// Visible to participants only (meeting point, what to bring).
  notes              String?             @db.VarChar(500)
  publishedAt        DateTime?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancelledById      String?
  cancelReason       String?             @db.VarChar(500)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organizer    User              @relation("GameOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  cancelledBy  User?             @relation("GameCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  booking      Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  location     Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  court        Court             @relation(fields: [courtId], references: [id], onDelete: Restrict)
  pair         Pair?             @relation("SessionPair", fields: [pairId], references: [id], onDelete: SetNull)
  participants GameParticipant[]
  requests     GameJoinRequest[]
  thread       MessageThread?

  @@index([organizerId, startsAt(sort: Desc)])
  @@index([locationId, startsAt])
  @@index([status, visibility, startsAt])
}

/// Who is in a game. Invited players must accept themselves; nothing accepts on their behalf.
model GameParticipant {
  id          String                @id @default(cuid())
  sessionId   String
  userId      String
  role        GameParticipantRole   @default(PLAYER)
  status      GameParticipantStatus @default(INVITED)
  invitedById String?
  /// Set when the player joined as half of a pair; the lineup shows teams.
  pairId      String?
  invitedAt   DateTime              @default(now())
  respondedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation("GameParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?       @relation("GameParticipantInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  pair      Pair?       @relation("ParticipantPair", fields: [pairId], references: [id], onDelete: SetNull)
  invoices  Invoice[]

  @@unique([sessionId, userId])
  @@index([userId, status])
}

/// A player (or a pair) asking for open spots. Organizers decide; nothing is accepted automatically.
/// `spots` is 1 for SOLO and 2 for PAIR and is reserved atomically on acceptance (see matchmaking.ts).
model GameJoinRequest {
  id           String            @id @default(cuid())
  sessionId    String
  /// The requesting player; for a PAIR request, the member who sent it.
  userId       String
  kind         GameRequestKind   @default(SOLO)
  pairId       String?
  spots        Int               @default(1)
  status       GameRequestStatus @default(PENDING)
  message      String?           @db.VarChar(300)
  /// Deterministic match score and the reasons shown to both sides, captured when the request was made.
  score        Int               @default(0)
  reasons      String[]          @default([])
  expiresAt    DateTime?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?           @db.VarChar(300)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation("GameRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  pair      Pair?       @relation("RequestPair", fields: [pairId], references: [id], onDelete: SetNull)
  decidedBy User?       @relation("GameRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([sessionId, status])
  @@index([userId, status])
}

/// Two players who play together. Created by one, confirmed by the other; a pair requests both spots at once
/// and is never split. playerAId < playerBId so a duo exists once.
model Pair {
  id          String     @id @default(cuid())
  name        String?    @db.VarChar(60)
  playerAId   String
  playerBId   String
  createdById String
  status      PairStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  playerA      User              @relation("PairPlayerA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerB      User              @relation("PairPlayerB", fields: [playerBId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("PairCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  sessions     GameSession[]     @relation("SessionPair")
  participants GameParticipant[] @relation("ParticipantPair")
  requests     GameJoinRequest[] @relation("RequestPair")

  @@unique([playerAId, playerBId])
  @@index([playerBId, status])
}

/// Academy-wide matchmaking rules. One row ("default"); only global roles change it.
model MatchmakingConfig {
  id                  String   @id @default("default")
  /// When true, a session whose levelPolicy is ADJACENT also welcomes one rank above and below.
  allowAdjacentLevels Boolean  @default(false)
  /// Pending requests expire this long after they are made (and always when the game starts).
  requestExpiryHours  Int      @default(48)
  /// Open requests a player may have at once.
  maxOpenRequests     Int      @default(5)
  updatedAt           DateTime @updatedAt
}

/// Academy-wide identity and policy, edited from Admin, Settings. A single row with the id "default";
/// every screen that needs the academy's name, contact details or standard policy wording reads it.
model AcademySettings {
  id                 String   @id @default("default")
  name               String   @default("HITTERS Sports Academy") @db.VarChar(120)
  tagline            String?  @db.VarChar(200)
  supportEmail       String   @default("hello@hitters.academy") @db.VarChar(160)
  supportPhone       String?  @db.VarChar(40)
  /// Default zone for new locations and for anything not tied to one club.
  defaultTimezone    String   @default("Africa/Cairo")
  currency           String   @default("EGP") @db.VarChar(8)
  /// Shown to players before they confirm a booking.
  cancellationPolicy String   @default("Free cancellation up to 12 hours before the booking. Later cancellations are charged in full.") @db.VarChar(600)
  updatedById        String?
  updatedAt          DateTime @updatedAt

  updatedBy User? @relation("AcademySettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------- Academy: trainers, lessons, programs, packages

/// Public coaching profile of a user who holds the TRAINER role at one or more locations.
model TrainerProfile {
  id               String        @id @default(cuid())
  userId           String        @unique
  title            String        @db.VarChar(80)
  bio              String?       @db.VarChar(2000)
  photoUrl         String?
  qualifications   String[]      @default([])
  languages        String[]      @default([])
  specialties      String[]      @default([])
  /// Levels this trainer coaches. Empty = every level.
  levels           PlayerLevel[] @default([])
  hourlyRateCents  Int
  currency         String        @default("EGP")
  /// Lesson lengths offered, in minutes.
  durationsMinutes Int[]         @default([60])
  /// When false, new lessons start REQUESTED and the trainer confirms each one.
  autoConfirm      Boolean       @default(true)
  status           TrainerStatus @default(ACTIVE)
  yearsExperience  Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations     TrainerLocation[]
  availability  TrainerAvailability[]
  timeOff       TrainerTimeOff[]
  lessons       Lesson[]
  programs      Program[]
  progressNotes ProgressNote[]
  packages      TrainingPackage[]

  @@index([status])
}

model TrainerLocation {
  id         String @id @default(cuid())
  trainerId  String
  locationId String

  trainer  TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([trainerId, locationId])
}

/// Weekly coaching hours per location; lessons are offered inside these windows.
model TrainerAvailability {
  id           String @id @default(cuid())
  trainerId    String
  locationId   String
  dayOfWeek    Int
  startMinutes Int
  endMinutes   Int

  trainer  TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([trainerId, dayOfWeek])
}

model TrainerTimeOff {
  id        String   @id @default(cuid())
  trainerId String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?  @db.VarChar(200)

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, startsAt])
}

/// A private lesson. Overlapping active lessons for one trainer are rejected by the Lesson_trainer_no_overlap
/// exclusion constraint (migration 20261003110000_academy) as well as by the service lock.
model Lesson {
  id                 String       @id @default(cuid())
  code               String       @unique
  trainerId          String
  playerId           String
  locationId         String
  courtId            String?
  startsAt           DateTime
  endsAt             DateTime
  durationMinutes    Int
  status             LessonStatus @default(CONFIRMED)
  priceCents         Int
  currency           String       @default("EGP")
  /// What the player wants to work on.
  focus              String?      @db.VarChar(500)
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?      @db.VarChar(500)
  rescheduledFromId  String?      @unique
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  trainer         TrainerProfile     @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  player          User               @relation("LessonPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  location        Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  court           Court?             @relation(fields: [courtId], references: [id], onDelete: SetNull)
  cancelledBy     User?              @relation("LessonCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdBy       User?              @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rescheduledFrom Lesson?            @relation("LessonReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Lesson?            @relation("LessonReschedule")
  payments        Payment[]
  invoices        Invoice[]
  redemption      PackageRedemption?
  notes           ProgressNote[]

  @@index([trainerId, startsAt])
  @@index([playerId, startsAt(sort: Desc)])
  @@index([locationId, startsAt])
  @@index([status, startsAt])
}

/// A trainer's note about a player. PRIVATE notes are seen by the author and location staff with training.read;
/// SHARED notes are also shown to the player.
model ProgressNote {
  id         String         @id @default(cuid())
  trainerId  String
  playerId   String
  lessonId   String?
  programId  String?
  body       String         @db.VarChar(2000)
  visibility NoteVisibility @default(PRIVATE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  player  User           @relation("NotePlayer", fields: [playerId], references: [id], onDelete: Cascade)
  lesson  Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  program Program?       @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([playerId, createdAt(sort: Desc)])
  @@index([trainerId, createdAt(sort: Desc)])
}

/// A multi-session training program run by one trainer at one location.
model Program {
  id                      String          @id @default(cuid())
  code                    String          @unique
  name                    String          @db.VarChar(120)
  category                ProgramCategory @default(GROUP_COACHING)
  description             String?         @db.VarChar(2000)
  /// Level requirement. Empty = any level; players without an official level are admitted only when empty.
  levels                  PlayerLevel[]   @default([])
  minAge                  Int?
  maxAge                  Int?
  trainerId               String
  locationId              String
  startsOn                DateTime        @db.Date
  endsOn                  DateTime        @db.Date
  /// Weekly slots: [{ dayOfWeek, startMinutes, durationMinutes }]
  schedule                Json
  sessionsCount           Int
  capacity                Int
  priceCents              Int
  currency                String          @default("EGP")
  allowWaitlist           Boolean         @default(true)
  enrollmentClosesAt      DateTime?
  cancellationCutoffHours Int             @default(72)
  enrollmentRules         String?         @db.VarChar(1000)
  cancellationRules       String?         @db.VarChar(1000)
  status                  ProgramStatus   @default(DRAFT)
  createdById             String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  trainer     TrainerProfile      @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  location    Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy   User?               @relation("ProgramCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sessions    ProgramSession[]
  enrollments ProgramEnrollment[]
  notes       ProgressNote[]
  thread      MessageThread?

  @@index([locationId, startsOn])
  @@index([status, startsOn])
  @@index([trainerId, startsOn])
}

model ProgramSession {
  id        String               @id @default(cuid())
  programId String
  index     Int
  startsAt  DateTime
  endsAt    DateTime
  courtId   String?
  status    ProgramSessionStatus @default(SCHEDULED)
  topic     String?              @db.VarChar(200)

  program    Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  court      Court?              @relation(fields: [courtId], references: [id], onDelete: SetNull)
  attendance ProgramAttendance[]

  @@unique([programId, index])
  @@index([startsAt])
}

model ProgramEnrollment {
  id           String           @id @default(cuid())
  programId    String
  playerId     String
  status       EnrollmentStatus @default(ENROLLED)
  /// Order on the waitlist (1 = next in line). Null once enrolled.
  position     Int?
  enrolledAt   DateTime?
  cancelledAt  DateTime?
  cancelReason String?          @db.VarChar(500)
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  program    Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  player     User                @relation("EnrollmentPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  createdBy  User?               @relation("EnrollmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attendance ProgramAttendance[]
  payments   Payment[]
  invoices   Invoice[]

  @@unique([programId, playerId])
  @@index([playerId, status])
  @@index([programId, status, position])
}

model ProgramAttendance {
  id           String           @id @default(cuid())
  sessionId    String
  enrollmentId String
  status       AttendanceStatus @default(PRESENT)
  markedById   String?
  markedAt     DateTime         @default(now())

  session    ProgramSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  markedBy   User?             @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, enrollmentId])
}

/// A prepaid bundle of lessons for sale. trainerId / locationId restrict where the credits may be used.
model TrainingPackage {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(80)
  description  String?  @db.VarChar(500)
  credits      Int
  priceCents   Int
  currency     String   @default("EGP")
  validityDays Int      @default(90)
  trainerId    String?
  locationId   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trainer   TrainerProfile?   @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  location  Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  purchases PackagePurchase[]

  @@index([active])
}

/// A player's purchased package: credits, usage and expiry. Payment stays in Payment.
model PackagePurchase {
  id          String         @id @default(cuid())
  code        String         @unique
  playerId    String
  packageId   String?
  name        String         @db.VarChar(80)
  credits     Int
  creditsUsed Int            @default(0)
  priceCents  Int
  currency    String         @default("EGP")
  trainerId   String?
  locationId  String?
  purchasedAt DateTime       @default(now())
  expiresAt   DateTime
  status      PurchaseStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  player      User                @relation("PurchasePlayer", fields: [playerId], references: [id], onDelete: Cascade)
  package     TrainingPackage?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions PackageRedemption[]
  payments    Payment[]
  invoices    Invoice[]

  @@index([playerId, status])
}

model PackageRedemption {
  id         String    @id @default(cuid())
  purchaseId String
  lessonId   String    @unique
  credits    Int       @default(1)
  redeemedAt DateTime  @default(now())
  refundedAt DateTime?

  purchase PackagePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  lesson   Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- Staff

/// Grants a location-scoped role to a user. A user may hold several roles at several locations.
model StaffMembership {
  id          String           @id @default(cuid())
  userId      String
  locationId  String
  role        StaffRole
  status      MembershipStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User     @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("MembershipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([userId, locationId, role])
  @@index([locationId, role, status])
  @@index([userId, status])
}

// ---------------------------------------------------------------- Messaging & audit

/// Outbox-style notification. IN_APP rows are read by the app; other channels are delivered by workers.
/// One notification event for one person. Per-channel delivery lives in NotificationDelivery, so a single
/// event can reach in-app, email, push and SMS independently while read state stays here.
model Notification {
  id        String               @id @default(cuid())
  userId    String
  type      String
  category  NotificationCategory @default(BOOKING)
  title     String
  body      String
  data      Json?
  /// Where tapping the notification goes, resolved when it is created.
  url       String?
  /// Related notifications sharing this key collapse into one row in the centre (e.g. all join requests for one game).
  groupKey  String?
  /// Suppresses an identical notification raised again inside the type's quiet window.
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, groupKey])
  @@index([userId, dedupeKey, createdAt])
  @@index([createdAt])
}

/// One attempt to put a notification on one channel. IN_APP is marked SENT immediately; the others wait for a
/// worker, which is why `provider` and `providerRef` exist but are unused until a provider is connected.
model NotificationDelivery {
  id             String              @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  sentAt         DateTime?
  failedAt       DateTime?
  attempts       Int                 @default(0)
  error          String?             @db.VarChar(500)
  provider       String?
  providerRef    String?
  createdAt      DateTime            @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, channel, createdAt])
}

/// Admin-editable wording for one notification type. Seeded from the code catalogue; `{{placeholders}}` are
/// filled from the notification's data. Missing row means the catalogue default is used.
model NotificationTemplate {
  id          String                @id @default(cuid())
  type        String                @unique
  category    NotificationCategory
  title       String                @db.VarChar(200)
  body        String                @db.VarChar(1000)
  /// Turning this off stops the type entirely, for everyone.
  enabled     Boolean               @default(true)
  /// Channels this type may use, before each person's own preferences narrow it.
  channels    NotificationChannel[] @default([IN_APP])
  updatedById String?
  updatedAt   DateTime              @updatedAt

  updatedBy User? @relation("TemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// One row per person per category. Absent means the defaults in notification-catalog.ts apply.
model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  category  NotificationCategory
  inApp     Boolean              @default(true)
  email     Boolean              @default(true)
  push      Boolean              @default(false)
  sms       Boolean              @default(false)
  updatedAt DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

// ---------------------------------------------------------------- Messaging

/// A group chat attached to a game or a program. Membership is derived from the lineup or the roster, so
/// nobody is added or removed here and no contact details are ever exposed.
model MessageThread {
  id         String            @id @default(cuid())
  kind       MessageThreadKind
  gameId     String?           @unique
  programId  String?           @unique
  /// Locked threads are read-only; staff lock one after a moderation decision.
  lockedAt   DateTime?
  lockedById String?
  createdAt  DateTime          @default(now())

  game     GameSession? @relation(fields: [gameId], references: [id], onDelete: Cascade)
  program  Program?     @relation(fields: [programId], references: [id], onDelete: Cascade)
  lockedBy User?        @relation("ThreadLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  messages Message[]
}

model Message {
  id          String    @id @default(cuid())
  threadId    String
  senderId    String
  body        String    @db.VarChar(2000)
  /// Soft delete: the row stays so reports and the audit trail keep their target.
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime  @default(now())

  thread    MessageThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User            @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  deletedBy User?           @relation("MessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  reports   MessageReport[]

  @@index([threadId, createdAt])
  @@index([senderId, createdAt(sort: Desc)])
}

model MessageReport {
  id           String       @id @default(cuid())
  messageId    String
  reporterId   String
  reason       String       @db.VarChar(60)
  note         String?      @db.VarChar(500)
  status       ReportStatus @default(OPEN)
  reviewedById String?
  reviewedAt   DateTime?
  outcome      String?      @db.VarChar(500)
  createdAt    DateTime     @default(now())

  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter   User    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("ReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([messageId, reporterId])
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  locationId String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([locationId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// ---------------------------------------------------------------- Money: invoices, payments, refunds, credit

/// What someone owes, and the only source of truth for "outstanding". Exactly one subject column is set,
/// naming what the invoice is for; the lines say how the total was reached.
///
/// subtotal - discount - credit = total, and total - paid - refunded is what is still due. Those cached
/// figures are recomputed by `recalculateInvoice` inside the same transaction as every payment, refund and
/// line change; no other code writes them.
model Invoice {
  id                String        @id @default(cuid())
  number            String        @unique
  playerId          String?
  /// A walk-in has no account, so the desk still gets a receipt with a name on it.
  guestName         String?       @db.VarChar(120)
  guestPhone        String?       @db.VarChar(40)
  locationId        String?
  currency          String        @default("EGP") @db.VarChar(8)
  subtotalCents     Int           @default(0)
  discountCents     Int           @default(0)
  creditCents       Int           @default(0)
  totalCents        Int           @default(0)
  paidCents         Int           @default(0)
  refundedCents     Int           @default(0)
  status            InvoiceStatus @default(DRAFT)
  /// Set when the policy takes a deposit: the part of the total due before the booking is confirmed.
  depositCents      Int           @default(0)
  dueAt             DateTime?
  issuedAt          DateTime?
  paidAt            DateTime?
  voidedAt          DateTime?
  voidReason        String?       @db.VarChar(300)
  note              String?       @db.VarChar(500)
  bookingId         String?
  lessonId          String?
  enrollmentId      String?
  purchaseId        String?
  membershipId      String?
  /// A player's share of a game whose cost is split.
  gameParticipantId String?
  couponId          String?
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  player          User?              @relation("InvoicePlayer", fields: [playerId], references: [id], onDelete: SetNull)
  location        Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy       User?              @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  booking         Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lesson          Lesson?            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrollment      ProgramEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  purchase        PackagePurchase?   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  membership      Membership?        @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  gameParticipant GameParticipant?   @relation(fields: [gameParticipantId], references: [id], onDelete: Cascade)
  coupon          Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  lines           InvoiceLine[]
  payments        Payment[]
  refunds         Refund[]
  intents         PaymentIntent[]
  creditEntries   CreditEntry[]
  redemption      CouponRedemption?

  @@index([playerId, createdAt(sort: Desc)])
  @@index([locationId, status])
  @@index([status, dueAt])
  @@index([bookingId])
  @@index([lessonId])
  @@index([enrollmentId])
  @@index([purchaseId])
  @@index([membershipId])
}

/// One line of an invoice. DISCOUNT and CREDIT lines carry a negative amount, so the lines always sum to
/// the total and a receipt can be printed straight from them.
model InvoiceLine {
  id          String          @id @default(cuid())
  invoiceId   String
  kind        InvoiceLineKind
  description String          @db.VarChar(200)
  quantity    Int             @default(1)
  unitCents   Int
  amountCents Int
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
}

/// One attempt to collect money through a provider.
///
/// The browser is never believed: a return from a checkout page only ever moves an intent to PROCESSING.
/// SUCCEEDED is written by `settleIntent`, which runs from a verified webhook or a server-side status
/// fetch. `idempotencyKey` is sent to the provider and stored here, so a retried call reuses the attempt
/// instead of charging twice.
model PaymentIntent {
  id             String              @id @default(cuid())
  invoiceId      String
  provider       String              @db.VarChar(40)
  /// The provider's own id for this attempt. Null until the provider has been called.
  providerRef    String?             @db.VarChar(200)
  amountCents    Int
  currency       String              @default("EGP") @db.VarChar(8)
  status         PaymentIntentStatus @default(REQUIRES_ACTION)
  idempotencyKey String              @unique
  /// Where the provider sends the player back. Never trusted for the outcome.
  returnUrl      String?             @db.VarChar(500)
  checkoutUrl    String?             @db.VarChar(1000)
  failureCode    String?             @db.VarChar(80)
  failureMessage String?             @db.VarChar(300)
  expiresAt      DateTime?
  confirmedAt    DateTime?
  /// Provider handles only. A card number, CVV or full PAN must never reach this column.
  metadata       Json?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("IntentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments  Payment[]

  @@unique([provider, providerRef])
  @@index([invoiceId, createdAt(sort: Desc)])
  @@index([status])
}

/// Every inbound provider callback, stored before it is acted on.
///
/// The unique key is the provider's own event id, so a provider that retries a webhook (all of them do)
/// cannot pay an invoice twice: the second delivery finds the row and stops.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @db.VarChar(40)
  eventId     String    @db.VarChar(200)
  type        String    @db.VarChar(120)
  /// SHA-256 of the exact bytes received, so a replay with a tampered body is visible.
  payloadHash String    @db.VarChar(64)
  payload     Json
  signatureOk Boolean   @default(false)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?   @db.VarChar(500)

  @@unique([provider, eventId])
  @@index([processedAt])
  @@index([receivedAt(sort: Desc)])
}

/// Money going back out. Separate from Payment because a refund has its own lifecycle, its own provider
/// call and its own authorisation; a payment is never edited into a refund.
model Refund {
  id             String            @id @default(cuid())
  invoiceId      String
  paymentId      String?
  amountCents    Int
  currency       String            @default("EGP") @db.VarChar(8)
  destination    RefundDestination @default(ORIGINAL)
  status         RefundStatus      @default(PENDING)
  reason         String?           @db.VarChar(300)
  provider       String?           @db.VarChar(40)
  providerRef    String?           @db.VarChar(200)
  idempotencyKey String            @unique
  failureMessage String?           @db.VarChar(300)
  requestedById  String?
  settledAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  requestedBy User?        @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  creditEntry CreditEntry?

  @@index([invoiceId])
  @@index([status, createdAt(sort: Desc)])
}

/// A player's academy credit, in money. Distinct from a package's lesson credits, which are counted in
/// lessons and only spend on that package's coach.
model CreditAccount {
  id           String   @id @default(cuid())
  playerId     String   @unique
  currency     String   @default("EGP") @db.VarChar(8)
  /// Cached sum of the entries, written in the same transaction as each entry. The ledger is authoritative.
  balanceCents Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  player  User          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  entries CreditEntry[]
}

/// Append-only. Entries are never edited or deleted; a mistake is corrected with an opposing ADJUSTMENT.
model CreditEntry {
  id                String          @id @default(cuid())
  accountId         String
  kind              CreditEntryKind
  /// Signed: positive adds to the balance, negative spends it.
  amountCents       Int
  balanceAfterCents Int
  reason            String?         @db.VarChar(300)
  invoiceId         String?
  refundId          String?         @unique
  createdById       String?
  createdAt         DateTime        @default(now())

  account   CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  refund    Refund?       @relation(fields: [refundId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("CreditEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------- Memberships and coupons

/// What a membership costs and what it gives. `key` is the tier a MEMBERSHIP_DISCOUNT pricing rule matches,
/// so the discount on court bookings is configured where every other price is.
model MembershipPlan {
  id                  String        @id @default(cuid())
  key                 String        @unique @db.VarChar(40)
  name                String        @db.VarChar(80)
  description         String?       @db.VarChar(500)
  priceCents          Int
  currency            String        @default("EGP") @db.VarChar(8)
  period              BillingPeriod @default(MONTHLY)
  benefits            String[]      @default([])
  /// Academy credit granted at the start of every period.
  periodCreditCents   Int           @default(0)
  freeAssessments     Int           @default(0)
  /// Extra days of the booking window, over the club's own advanceBookingDays.
  priorityBookingDays Int           @default(0)
  /// null = sold at every club.
  locationId          String?
  active              Boolean       @default(true)
  sortOrder           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  location    Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([active, sortOrder])
}

/// One player's term on a plan. A term is a dated period, so a membership bought at the desk and one that
/// renews itself are the same record; `autoRenew` only decides whether the next term is created.
model Membership {
  id           String               @id @default(cuid())
  code         String               @unique
  playerId     String
  planId       String
  status       MembershipTermStatus @default(PENDING)
  startsOn     DateTime             @db.Date
  endsOn       DateTime             @db.Date
  autoRenew    Boolean              @default(false)
  cancelledAt  DateTime?
  cancelReason String?              @db.VarChar(300)
  createdById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  player    User           @relation("MembershipPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  plan      MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("MembershipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  invoices  Invoice[]
  payments  Payment[]

  @@index([playerId, status])
  @@index([status, endsOn])
}

/// A code that takes money off an invoice. Percent coupons may be capped; both kinds may be limited to
/// certain line kinds, a club, a window, a total number of uses and a number of uses per player.
model Coupon {
  id               String            @id @default(cuid())
  code             String            @unique @db.VarChar(40)
  name             String            @db.VarChar(120)
  kind             CouponKind
  /// PERCENT: 1 to 100. FIXED: an amount in cents.
  value            Int
  maxDiscountCents Int?
  minSpendCents    Int?
  /// Empty = anything on the invoice.
  appliesTo        InvoiceLineKind[] @default([])
  locationId       String?
  validFrom        DateTime?
  validTo          DateTime?
  maxRedemptions   Int?
  maxPerPlayer     Int               @default(1)
  /// Cached count of redemptions, incremented in the same transaction as each one.
  redeemedCount    Int               @default(0)
  active           Boolean           @default(true)
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  location    Location?          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("CouponCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  invoices    Invoice[]
  redemptions CouponRedemption[]

  @@index([active, validTo])
}

/// Append-only proof that a coupon was used, one per invoice, so a per-player limit can be enforced and a
/// coupon's real cost can be reported.
model CouponRedemption {
  id          String   @id @default(cuid())
  couponId    String
  playerId    String?
  invoiceId   String   @unique
  amountCents Int
  createdAt   DateTime @default(now())

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  player  User?   @relation("CouponRedemptionPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([couponId, playerId])
}

// ---------------------------------------------------------------- Payment policy

/// When and how a club takes money, and what it keeps when a player cancels.
/// The row with a null locationId is the academy default; a row with a locationId overrides it for that club.
model PaymentPolicy {
  id                      String            @id @default(cuid())
  locationId              String?           @unique
  timing                  PaymentTiming     @default(AT_CLUB)
  /// Percent of the total taken up front when paying online. 0 = the whole amount.
  depositPercent          Int               @default(0)
  /// Percent of the total kept when a player cancels after the club's cancellation cutoff.
  lateCancellationPercent Int               @default(0)
  /// Percent kept when a player simply does not turn up.
  noShowPercent           Int               @default(0)
  refundDestination       RefundDestination @default(ORIGINAL)
  /// Hours before the start after which a cancellation is refunded nothing at all.
  refundCutoffHours       Int               @default(0)
  /// How a game's cost is divided unless its organizer chooses otherwise.
  defaultGameCostMode     GameCostMode      @default(SPLIT_EVENLY)
  /// Whether players may pay from their academy credit balance.
  allowCredit             Boolean           @default(true)
  updatedById             String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
}
